{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nr1webdevelopment/pocket-formulary/schema/provider.schema.json",
  "title": "Health service provider",
  "description": "One place where people can get care for a condition in this dataset (HIV, ADHD, diabetes) in one of the cities in data/cities.json. Booleans in `services` are true (offered), false (not offered) or null (unknown / not confirmed). Which service keys must be present depends on `conditions`.",
  "type": "object",
  "required": [
    "id",
    "conditions",
    "city",
    "name",
    "organization",
    "type",
    "operator",
    "location",
    "contact",
    "services",
    "sources",
    "verification",
    "updated"
  ],
  "additionalProperties": false,
  "$defs": {
    "triState": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "localized": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "th": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hans": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "type": [
            "string",
            "null"
          ]
        },
        "es": {
          "type": [
            "string",
            "null"
          ]
        },
        "pt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Official or local-language versions keyed by language tag. Translations for display live in i18n/."
    },
    "localizedOptional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "th": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hans": {
          "type": [
            "string",
            "null"
          ]
        },
        "zh-Hant": {
          "type": [
            "string",
            "null"
          ]
        },
        "es": {
          "type": [
            "string",
            "null"
          ]
        },
        "pt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]{3}-[a-z0-9-]+$",
      "description": "Stable ID: <country>-<city>-<slug>. Never reused."
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hiv",
          "adhd",
          "diabetes"
        ]
      },
      "description": "Conditions this provider is listed for. Matches medicine `condition`."
    },
    "city": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "City code from data/cities.json (e.g. bkk, sha, hkg, mfm, tpe, sin, sfo, lax, gdl, lis)."
    },
    "name": {
      "$ref": "#/$defs/localized",
      "description": "Official names. `en` required; local-language names (th, zh-Hans, zh-Hant, es, pt) where the provider uses them."
    },
    "organization": {
      "type": "string"
    },
    "type": {
      "enum": [
        "public_hospital",
        "public_clinic",
        "bma_health_centre",
        "ngo_clinic",
        "key_population_clinic",
        "private_clinic",
        "private_hospital"
      ]
    },
    "operator": {
      "enum": [
        "government_national",
        "government_regional",
        "government_local",
        "government_bma",
        "red_cross",
        "university",
        "ngo",
        "private"
      ]
    },
    "network": {
      "$ref": "#/$defs/nullableString"
    },
    "location": {
      "type": "object",
      "required": [
        "country",
        "province",
        "city"
      ],
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "province": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "area": {
          "$ref": "#/$defs/nullableString"
        },
        "district": {
          "$ref": "#/$defs/nullableString"
        },
        "address": {
          "$ref": "#/$defs/localizedOptional"
        },
        "postcode": {
          "type": [
            "string",
            "null"
          ]
        },
        "locationNote": {
          "$ref": "#/$defs/nullableString"
        },
        "nearestTransit": {
          "$ref": "#/$defs/nullableString"
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line": {
          "$ref": "#/$defs/nullableString"
        },
        "website": {
          "oneOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "$ref": "#/$defs/nullableString"
        },
        "booking": {
          "oneOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hours": {
      "$ref": "#/$defs/nullableString"
    },
    "services": {
      "type": "object",
      "required": [
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "hivTesting": {
          "$ref": "#/$defs/triState"
        },
        "prep": {
          "$ref": "#/$defs/triState"
        },
        "pep": {
          "$ref": "#/$defs/triState"
        },
        "art": {
          "$ref": "#/$defs/triState"
        },
        "stiTesting": {
          "$ref": "#/$defs/triState"
        },
        "genderAffirmingHormones": {
          "$ref": "#/$defs/triState"
        },
        "adhdAssessmentChildren": {
          "$ref": "#/$defs/triState",
          "description": "ADHD assessment/diagnosis for children and teens"
        },
        "adhdAssessmentAdults": {
          "$ref": "#/$defs/triState",
          "description": "ADHD assessment/diagnosis for adults"
        },
        "adhdMedication": {
          "$ref": "#/$defs/triState",
          "description": "Prescribes ADHD medication"
        },
        "diabetesCare": {
          "$ref": "#/$defs/triState",
          "description": "Diabetes care for adults"
        },
        "diabetesCareChildren": {
          "$ref": "#/$defs/triState",
          "description": "Diabetes care for children"
        },
        "endocrinologist": {
          "$ref": "#/$defs/triState",
          "description": "Endocrinologist on staff"
        },
        "insulinPump": {
          "$ref": "#/$defs/triState",
          "description": "Insulin pump therapy"
        },
        "cgm": {
          "$ref": "#/$defs/triState",
          "description": "Continuous glucose monitoring"
        },
        "diabetesEducation": {
          "$ref": "#/$defs/triState",
          "description": "Diabetes education / self-management teaching"
        },
        "diabeticFootCare": {
          "$ref": "#/$defs/triState",
          "description": "Diabetic foot care"
        },
        "basis": {
          "enum": [
            "site",
            "network",
            "third_party"
          ],
          "description": "site = stated for this location; network = stated for the provider network as a whole; third_party = from a directory or news report"
        },
        "note": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "description": "Required keys by condition: hiv → hivTesting, prep, pep, art; adhd → adhdAssessmentChildren, adhdAssessmentAdults, adhdMedication; diabetes → diabetesCare, diabetesCareChildren (checked by scripts/validate.py)."
    },
    "populationFocus": {
      "type": "array",
      "items": {
        "enum": [
          "general",
          "children",
          "msm",
          "transgender",
          "sex_workers",
          "lgbtqia",
          "youth",
          "migrants",
          "people_who_use_drugs"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost": {
          "enum": [
            "free",
            "low_cost",
            "fee",
            "mixed",
            null
          ]
        },
        "walkIn": {
          "$ref": "#/$defs/triState"
        },
        "foreignersAccepted": {
          "$ref": "#/$defs/triState"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "type",
          "accessed"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "$ref": "#/$defs/url"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "type": {
            "enum": [
              "official_provider_site",
              "government_announcement",
              "government_registry",
              "third_party_directory",
              "news",
              "phone_call",
              "email"
            ]
          },
          "accessed": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "sourceChecked"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "needs_review",
            "closed"
          ],
          "description": "verified = confirmed directly with the provider (phone/email/visit) on lastVerified"
        },
        "sourceChecked": {
          "$ref": "#/$defs/date"
        },
        "lastVerified": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "phone",
            "email",
            "in_person",
            "official_registry",
            null
          ]
        },
        "verifiedBy": {
          "$ref": "#/$defs/nullableString"
        },
        "nextReviewDue": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "notes": {
      "$ref": "#/$defs/nullableString"
    },
    "updated": {
      "$ref": "#/$defs/date"
    }
  }
}
